{
  "name": "nightfall",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AI Werewolf platform — referee-in-frontend, agentd-backed AI seats",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "play": "tsx scripts/play.ts",
    "smoke": "bash scripts/smoke-turn.sh"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/minifish-org/nightfall.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
